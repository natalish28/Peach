terraform {
  required_version = ">= 1.10"

  # The workspace holds the state and runs plan/apply with dynamic AWS credentials.
  cloud {
    organization = "miunafw"

    workspaces {
      name = "peach-dev"
    }
  }

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.7"
    }
  }
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      PROJECT_NAME = var.project_name
      ManagedBy    = "terraform"
    }
  }
}

data "aws_caller_identity" "current" {}
